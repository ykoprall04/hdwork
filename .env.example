# Public template. Run npm.cmd run setup:local to create missing private files.
NODE_ENV=development
PORT=3090
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hdwork2
DB_USER=hdwork_auth
DB_PASSWORD=
DB_PASSWORD_DPAPI_FILE=.local/hdwork-auth.password.dpapi
JWT_SECRET=
FRONTEND_ORIGINS=https://localhost:8443
HDWORK2_AUTH_V2=true
HDWORK2_OPERATIONS_ENABLED=true
B2C_COMMAND_SCHEMA_READY=true
B2C_WORKFLOW_READ_ENABLED=true
B2C_STAGING_ENABLED=false
COURIER_ENABLED=false
COURIER_ALLOW_NETWORK=false
# Keep true until writes (including login audit/session) are explicitly approved.
HDWORK2_LOCAL_READ_ONLY=true
LOCAL_HTTPS_PORT=8443
LOCAL_TLS_CERT=.local/tls/localhost.crt
LOCAL_TLS_KEY=.local/tls/localhost.key
